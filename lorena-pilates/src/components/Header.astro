---
import { site } from "../data/site";
import WhatsAppLink from "./WhatsAppLink.astro";
---
<header class="absolute inset-x-0 top-0 z-20">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-5 py-5 sm:px-8" aria-label="Navegación principal">
    <a href="#inicio" class="text-sm font-semibold tracking-[0.12em] text-[var(--olive)] sm:text-base">{site.name}</a>
    <div class="hidden items-center gap-7 text-sm text-[var(--ink)] md:flex">
      <a class="hover:text-[var(--olive)]" href="#clases">Las clases</a>
      <a class="hover:text-[var(--olive)]" href="#lorena">Sobre Lorena</a>
      <a class="hover:text-[var(--olive)]" href="#horarios">Horarios</a>
    </div>
    <WhatsAppLink label="Consultar" class="rounded-full bg-[var(--olive)] px-4 py-2.5 text-sm font-medium text-white transition hover:bg-[#344232]" />
  </nav>
</header>