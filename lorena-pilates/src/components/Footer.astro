---
import { site } from "../data/site";

const updatedLabel = new Date(`${site.lastUpdated}T00:00:00Z`).toLocaleDateString("es-AR", {
  month: "long",
  year: "numeric",
});
---
<footer class="border-t border-[#e2d9cc] py-7">
  <div class="mx-auto flex max-w-7xl flex-col gap-4 px-5 text-xs text-stone-500 sm:px-8 md:flex-row md:items-center md:justify-between">
    <img src={site.logo} alt={site.brand} class="h-20 w-auto sm:h-24" width="300" height="379" />
    <div class="flex flex-col gap-1 md:items-end">
      <p>© {new Date().getFullYear()} {site.brand}.</p>
      <p>Adrogué y Burzaco, Buenos Aires · <a href="/privacidad" class="underline underline-offset-4 transition hover:text-[var(--olive)]">Política de Privacidad</a></p>
      <p>Actualizado: {updatedLabel}</p>
    </div>
  </div>
</footer>
