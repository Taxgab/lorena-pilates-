---
import { site } from "../data/site";
---
<footer class="border-t border-[#e2d9cc] py-7">
  <div class="mx-auto flex max-w-7xl flex-col gap-4 px-5 text-xs text-stone-500 sm:px-8 md:flex-row md:items-center md:justify-between">
    <img src={site.logo} alt={site.brand} class="h-16 w-auto sm:h-20" width="300" height="425" />
    <div class="flex flex-col gap-1 md:items-end">
      <p>© {new Date().getFullYear()} {site.name}. Pilates Mat.</p>
      <p>Burzaco, Buenos Aires · Sitio informativo.</p>
    </div>
  </div>
</footer>