<section id="clases" class="py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--olive)]">La práctica</p>
      <h2 class="mt-4 font-serif text-4xl text-[var(--ink)] sm:text-5xl">Pilates Mat, a tu ritmo.</h2>
      <p class="mt-5 leading-7 text-stone-600">Una práctica sobre colchoneta que trabaja el control del movimiento, la respiración, la fuerza y la movilidad, con atención a cada detalle. En formato grupal, presencial o personalizado.</p>
    </div>
    <h3 class="mt-12 font-serif text-2xl text-[var(--ink)] sm:text-3xl">¿Qué podés trabajar?</h3>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {[
        "Fortalecimiento y resistencia muscular",
        "Movilidad y flexibilidad",
        "Control corporal y coordinación",
        "Conciencia postural",
        "Respiración y concentración",
        "Bienestar físico y mental",
      ].map((item, index) => (
        <article class="flex items-center gap-4 rounded-2xl border border-[#e4ddd2] bg-[#faf8f3] px-5 py-4">
          <span class="font-serif text-xl text-[var(--sage)]">{String(index + 1).padStart(2, "0")}</span>
          <span class="text-sm font-medium text-[var(--ink)]">{item}</span>
        </article>
      ))}
    </div>
    <p class="mt-6 text-xs text-stone-500">La descripción de los beneficios es general y no constituye una promesa de resultados médicos.</p>
  </div>
</section>
