---
import { site } from "../data/site";
import WhatsAppLink from "./WhatsAppLink.astro";
---
<section id="inicio" class="relative isolate overflow-hidden">
  <div class="mx-auto grid min-h-[720px] max-w-7xl items-center gap-10 px-5 pb-16 pt-28 sm:px-8 md:grid-cols-[1fr_0.88fr] md:pb-24 md:pt-32">
    <div class="relative z-10 max-w-2xl">
      <p class="mb-5 text-xs font-semibold uppercase tracking-[0.22em] text-[var(--olive)]">Pilates Mat · {site.location}</p>
      <h1 class="font-serif text-5xl leading-[1.05] tracking-tight text-[var(--ink)] sm:text-6xl lg:text-7xl">
        Encontrá tu<br /><em class="font-normal text-[var(--olive)]">propio equilibrio.</em>
      </h1>
      <p class="mt-7 max-w-lg text-base leading-7 text-stone-600 sm:text-lg">
        Un espacio para conectar con tu cuerpo a través del movimiento consciente, desarrollar fuerza y movilidad y dedicarte un momento para vos.
      </p>
      <p class="mt-4 text-sm font-medium text-[var(--olive)]">Clases grupales, presenciales y personalizadas · 50 minutos</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <WhatsAppLink class="inline-flex items-center justify-center rounded-full bg-[var(--olive)] px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-[#344232]" />
        <a href="#clases" class="text-sm font-semibold text-[var(--olive)] underline decoration-[var(--sage)] underline-offset-4">Conocer las clases</a>
      </div>
      <p class="mt-4 text-xs text-stone-500">Burzaco · Zona sur de Buenos Aires</p>
    </div>
    <div class="relative mx-auto w-full max-w-xl">
      <div class="absolute -right-5 -top-5 h-36 w-36 rounded-full bg-[var(--sand)] sm:-right-8 sm:-top-8 sm:h-48 sm:w-48"></div>
      <div class="relative aspect-[4/5] overflow-hidden rounded-t-[48%] rounded-b-3xl bg-[var(--sand)] shadow-xl">
        <img
          src={site.heroImage}
          alt="Imagen de referencia de movimiento y bienestar; reemplazar por una fotografía autorizada de Lorena dando Pilates Mat"
          class="h-full w-full object-cover"
          fetchpriority="high"
          width="900"
          height="1125"
        />
      </div>
      <div class="absolute -bottom-5 left-3 rounded-2xl border border-white/70 bg-white/90 px-5 py-4 shadow-lg backdrop-blur sm:left-[-2rem]">
        <p class="font-serif text-xl text-[var(--olive)]">Movimiento consciente</p>
        <p class="mt-1 text-xs text-stone-500">Respiración · Control · Bienestar</p>
      </div>
    </div>
  </div>
</section>