---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${site.brand} | Pilates Mat en Adrogué y Burzaco`,
  description = "Clases grupales, presenciales y personalizadas de Pilates Mat en Adrogué y Burzaco, con 8 años de experiencia. Consultá horarios y disponibilidad.",
} = Astro.props;
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const ogImageUrl = Astro.site ? new URL("/og-image.jpg", Astro.site).toString() : undefined;
const ogImageAlt = `${site.brand} · Pilates Mat en Adrogué y Burzaco`;

const siteUrl = Astro.site ? new URL("/", Astro.site).toString() : undefined;
const structuredData =
  siteUrl && canonicalUrl
    ? {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": `${siteUrl}#organization`,
            name: site.brand,
            url: siteUrl,
            logo: new URL(site.logo, siteUrl).toString(),
            sameAs: [site.instagramUrl],
          },
          {
            "@type": "Person",
            "@id": `${siteUrl}#person`,
            name: site.name,
            jobTitle: site.profession,
            image: new URL(site.heroImage, siteUrl).toString(),
            worksFor: { "@id": `${siteUrl}#organization` },
            sameAs: [site.instagramUrl],
          },
          {
            "@type": "WebSite",
            "@id": `${siteUrl}#website`,
            url: siteUrl,
            name: site.brand,
            inLanguage: "es-AR",
          },
          {
            "@type": "WebPage",
            "@id": `${canonicalUrl}#webpage`,
            url: canonicalUrl,
            name: title,
            inLanguage: "es-AR",
            dateModified: site.lastUpdated,
            isPartOf: { "@id": `${siteUrl}#website` },
          },
        ],
      }
    : null;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f1e9" />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {structuredData && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_AR" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImageUrl && (
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogImageAlt} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>